{%- comment -%}
  Accepts: product (required), variant (optional – defaults to selected/first available)
{%- endcomment -%}
{%- liquid
  assign target = variant | default: product.selected_or_first_available_variant
  assign on_sale = false
  if target.compare_at_price > target.price
    assign on_sale = true
  endif
-%}
<div class="price{% if on_sale %} price--sale{% endif %}" data-price>
  {%- if product.price_varies and variant == blank -%}
    {%- assign min_price = product.price_min | money -%}
    <span class="price__current">{{ 'products.product.price_from' | t: price: min_price }}</span>
  {%- else -%}
    <span class="price__current">{{ target.price | money }}</span>
    {%- if on_sale -%}
      <s class="price__compare">{{ target.compare_at_price | money }}</s>
    {%- endif -%}
  {%- endif -%}
</div>

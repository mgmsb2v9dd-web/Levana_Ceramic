      { "type": "text", "id": "consent_marketing_label", "label": "נוסח הסכמה לדיוור", "default": "אני מסכים/ה לקבל עדכונים ומבצעים באימייל. אפשר להסיר את עצמי בכל עת." },
      { "type": "text", "id": "consent_contact_label", "label": "נוסח הסכמה לטופס יצירת קשר", "default": "אני מסכים/ה שהפרטים ישמשו רק לצורך מענה לפנייה זו, בהתאם למדיניות הפרטיות." },
      { "type": "page", "id": "privacy_request_page", "label": "עמוד בקשת עיון/מחיקת מידע", "info": "צרו עמוד עם התבנית page.privacy-request ובחרו אותו כאן" }

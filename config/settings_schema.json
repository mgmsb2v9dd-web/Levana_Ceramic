[
  {
    "name": "theme_info",
    "theme_name": "Levana Ceramic",
    "theme_version": "1.0.0",
    "theme_author": "Levana Ceramic",
    "theme_documentation_url": "https://github.com/mgmsb2v9dd-web/Levana_Ceramic",
    "theme_support_url": "https://github.com/mgmsb2v9dd-web/Levana_Ceramic"
  },
  {
    "name": "Colors",
    "settings": [
      { "type": "color", "id": "color_background", "label": "Background", "default": "#F7F2EC" },
      { "type": "color", "id": "color_surface", "label": "Secondary background (cards)", "default": "#EFE6DB" },
      { "type": "color", "id": "color_text", "label": "Text", "default": "#2E2621" },
      { "type": "color", "id": "color_muted", "label": "Secondary text", "default": "#7A6B5F" },
      { "type": "color", "id": "color_accent", "label": "Accent (buttons)", "default": "#A65D3F" },
      { "type": "color", "id": "color_accent_contrast", "label": "Text on accent", "default": "#FFFFFF" },
      { "type": "color", "id": "color_border", "label": "Borders", "default": "#DDD0C2" }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      { "type": "range", "id": "page_width", "label": "Max page width", "min": 1000, "max": 1600, "step": 20, "unit": "px", "default": 1280 },
      { "type": "range", "id": "corner_radius", "label": "Corner radius", "min": 0, "max": 24, "step": 2, "unit": "px", "default": 6 }
    ]
  },
  {
    "name": "Favicon",
    "settings": [
      { "type": "image_picker", "id": "favicon", "label": "Favicon", "info": "32 × 32 px" }
    ]
  },
  {
    "name": "Business details",
    "settings": [
      { "type": "paragraph", "content": "Israeli consumer protection law (remote sales) requires the seller's identity to be shown on the site. These details appear in the footer of every page." },
      { "type": "text", "id": "business_name", "label": "Business name", "default": "Levana's Magic" },
      { "type": "text", "id": "business_id", "label": "Business registration number", "placeholder": "000000000" },
      { "type": "select", "id": "business_type", "label": "Business type", "default": "exempt", "options": [
        { "value": "exempt", "label": "Exempt dealer (Osek Patur)" }, { "value": "licensed", "label": "Licensed dealer (Osek Murshe)" }
      ] },
      { "type": "text", "id": "business_address", "label": "Address" },
      { "type": "text", "id": "business_phone", "label": "Phone" },
      { "type": "text", "id": "business_email", "label": "Email" },
      { "type": "text", "id": "delivery_time", "label": "Estimated delivery time", "default": "3–7 business days" },
      { "type": "richtext", "id": "cancellation_note", "label": "Cancellation note (shown on product pages)", "default": "<p>You may cancel your purchase within 14 days of receiving the item, in accordance with Israeli consumer protection law. Custom-made pieces may be exempt from the right to cancel. See the refund policy for full details.</p>" }
    ]
  },
  {
    "name": "Privacy",
    "settings": [
      { "type": "paragraph", "content": "Consent checkboxes are shown unchecked and separately for each purpose (Privacy Protection Law, Amendment 13). Make sure a privacy policy is set in Settings > Policies." },
      { "type": "text", "id": "consent_marketing_label", "label": "Newsletter consent text", "default": "I agree to receive updates and offers by email. I can unsubscribe at any time." },
      { "type": "text", "id": "consent_contact_label", "label": "Contact form consent text", "default": "I agree that my details will be used only to reply to this enquiry, in line with the privacy policy." },
      { "type": "page", "id": "privacy_request_page", "label": "Data access / deletion request page", "info": "Create a page using the page.privacy-request template and select it here" }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      { "type": "text", "id": "social_instagram", "label": "Instagram", "placeholder": "https://instagram.com/..." },
      { "type": "text", "id": "social_facebook", "label": "Facebook", "placeholder": "https://facebook.com/..." },
      { "type": "text", "id": "social_whatsapp", "label": "WhatsApp (international format)", "placeholder": "9725XXXXXXXX" }
    ]
  }
]

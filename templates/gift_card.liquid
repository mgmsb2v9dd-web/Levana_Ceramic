{%- layout none -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}" dir="{{ 'general.direction' | t }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ 'gift_card.title' | t }} – {{ shop.name }}</title>
    {{ 'base.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    {{ content_for_header }}
  </head>
  <body class="template-gift-card">
    <main class="page-width page-width--narrow section empty-state">
      <h1 class="page-title">{{ shop.name }}</h1>
      <p>{{ 'gift_card.title' | t }}</p>
      <p class="hero__heading">{{ gift_card.balance | money }}</p>
      {%- if gift_card.expired or gift_card.enabled == false -%}
        <p class="form-error">{{ 'gift_card.expired' | t }}</p>
      {%- endif -%}
      <p><strong>{{ gift_card.code | format_code }}</strong></p>
      <div id="QrCode" data-identifier="{{ gift_card.qr_identifier }}"></div>
      <p>
        <a class="button" href="{{ shop.url }}">{{ 'gift_card.shop_link' | t }}</a>
        <button class="button button--outline" type="button" onclick="window.print()">{{ 'gift_card.print' | t }}</button>
      </p>
    </main>
    <script>
      window.addEventListener('load', function () {
        var el = document.getElementById('QrCode');
        if (window.QRCode && el) new QRCode(el, { text: el.dataset.identifier, width: 120, height: 120 });
      });
    </script>
  </body>
</html>

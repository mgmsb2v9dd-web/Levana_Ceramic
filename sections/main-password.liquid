<section class="password">
  <div class="password__inner">
    <h1 class="hero__heading">{{ shop.name }}</h1>
    {%- if shop.password_message != blank -%}
      <p>{{ shop.password_message }}</p>
    {%- else -%}
      <p>{{ 'password.coming_soon' | t }}</p>
    {%- endif -%}

    {%- form 'customer', class: 'newsletter' -%}
      <input type="hidden" name="contact[tags]" value="prospect,password page">
      <label for="PasswordNewsletter" class="newsletter__label">{{ 'password.notify' | t }}</label>
      <div class="newsletter__row">
        <input id="PasswordNewsletter" type="email" name="contact[email]" required placeholder="{{ 'general.email' | t }}">
        <button type="submit" class="button">{{ 'general.subscribe' | t }}</button>
      </div>
      {%- if form.posted_successfully? -%}<p class="form-success">{{ 'general.subscribed' | t }}</p>{%- endif -%}
    {%- endform -%}

    <details class="password__login">
      <summary>{{ 'password.owner_login' | t }}</summary>
      {%- form 'storefront_password' -%}
        {{ form.errors | default_errors }}
        <label for="Password" class="visually-hidden">{{ 'password.password' | t }}</label>
        <div class="newsletter__row">
          <input id="Password" type="password" name="password" autocomplete="current-password" placeholder="{{ 'password.password' | t }}">
          <button type="submit" class="button">{{ 'password.enter' | t }}</button>
        </div>
      {%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{
  "name": "Password page"
}
{% endschema %}

<section class="section">
  <div class="page-width page-width--narrow">
    <header class="page-header">
      <h1 class="page-title">{{ 'cart.title' | t }}</h1>
    </header>

    {%- if cart.item_count > 0 -%}
      <form action="{{ routes.cart_url }}" method="post" class="cart" novalidate>
        <ul class="cart__items">
          {%- for item in cart.items -%}
            <li class="cart-item">
              <a href="{{ item.url }}" class="cart-item__media">
                {%- if item.image -%}
                  {{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: item.title }}
                {%- endif -%}
              </a>
              <div class="cart-item__info">
                <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title }}</a>
                {%- unless item.product.has_only_default_variant -%}
                  <p class="cart-item__variant">{{ item.variant.title }}</p>
                {%- endunless -%}
                <p class="cart-item__price">{{ item.final_price | money }}</p>
              </div>
              <div class="cart-item__qty">
                <label class="visually-hidden" for="Updates-{{ item.key }}">{{ 'products.product.quantity' | t }}</label>
                <input id="Updates-{{ item.key }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0" inputmode="numeric">
                <a href="{{ item.url_to_remove }}" class="cart-item__remove">{{ 'cart.remove' | t }}</a>
              </div>
              <p class="cart-item__total">{{ item.final_line_price | money }}</p>
            </li>
          {%- endfor -%}
        </ul>

        <div class="cart__footer">
          <div class="field">
            <label for="CartNote">{{ 'cart.note' | t }}</label>
            <textarea id="CartNote" name="note" rows="3">{{ cart.note }}</textarea>
          </div>
          <div class="cart__summary">
            <p class="cart__subtotal">
              <span>{{ 'cart.subtotal' | t }}</span>
              <strong>{{ cart.total_price | money_with_currency }}</strong>
            </p>
            <p class="cart__taxes">{{ 'cart.taxes_shipping' | t }}</p>
            <button type="submit" name="update" class="button button--outline">{{ 'cart.update' | t }}</button>
            <button type="submit" name="checkout" class="button button--full">{{ 'cart.checkout' | t }}</button>
            {%- if additional_checkout_buttons -%}
              <div class="cart__dynamic-checkout">{{ content_for_additional_checkout_buttons }}</div>
            {%- endif -%}
          </div>
        </div>
      </form>
    {%- else -%}
      <div class="empty-state">
        <p>{{ 'cart.empty' | t }}</p>
        <a href="{{ routes.all_products_collection_url }}" class="button">{{ 'cart.continue' | t }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Cart"
}
{% endschema %}

<section class="section">
  <div class="page-width">
    <header class="page-header">
      <h1 class="page-title">{{ collection.title }}</h1>
      {%- if collection.description != blank -%}
        <div class="rte page-header__text">{{ collection.description }}</div>
      {%- endif -%}
    </header>

    {%- paginate collection.products by section.settings.per_page -%}
      <div class="collection-toolbar">
        <p class="collection-toolbar__count">{{ 'collections.products_count' | t: count: collection.products_count }}</p>
        <label class="collection-toolbar__sort">
          <span>{{ 'collections.sort_by' | t }}</span>
          <select data-sort-select>
            {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
            {%- for option in collection.sort_options -%}
              <option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name }}</option>
            {%- endfor -%}
          </select>
        </label>
      </div>

      <ul class="product-grid product-grid--{{ section.settings.columns }}">
        {%- for product in collection.products -%}
          <li>{% render 'product-card', product: product %}</li>
        {%- else -%}
          <li class="empty-state">{{ 'collections.empty' | t }}</li>
        {%- endfor -%}
      </ul>

      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection",
  "settings": [
    { "type": "range", "id": "per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 16 },
    { "type": "select", "id": "columns", "label": "Desktop columns", "default": "4", "options": [
      { "value": "3", "label": "3" }, { "value": "4", "label": "4" }
    ] }
  ]
}
{% endschema %}

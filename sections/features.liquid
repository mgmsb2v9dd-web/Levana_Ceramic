<section class="section section--tight">
  <div class="page-width">
    <ul class="features">
      {%- for block in section.blocks -%}
        <li class="feature" {{ block.shopify_attributes }}>
          {% render 'icon', name: block.settings.icon %}
          <h3 class="feature__title">{{ block.settings.title }}</h3>
          <p class="feature__text">{{ block.settings.text }}</p>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Features",
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "hand", "options": [
          { "value": "hand", "label": "Hand" }, { "value": "kiln", "label": "Flame" }, { "value": "truck", "label": "Delivery" }
        ] },
        { "type": "text", "id": "title", "label": "Title", "default": "Handmade" },
        { "type": "text", "id": "text", "label": "Text", "default": "Every piece is made individually on the wheel" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Features",
      "blocks": [
        { "type": "feature", "settings": { "icon": "hand", "title": "Handmade", "text": "Every piece is made individually – no two are alike" } },
        { "type": "feature", "settings": { "icon": "kiln", "title": "Kiln-fired ceramic", "text": "Durable, glazed ceramic made to last for years" } },
        { "type": "feature", "settings": { "icon": "truck", "title": "Packed with care", "text": "Nationwide delivery in padded packaging" } }
      ]
    }
  ]
}
{% endschema %}

{%- assign collection = section.settings.collection -%}
<section class="section">
  <div class="page-width">
    <div class="section__header">
      {%- if section.settings.heading != blank -%}<h2 class="section__heading">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if collection != blank -%}
        <a class="link-arrow" href="{{ collection.url }}">{{ 'general.view_all' | t }}</a>
      {%- endif -%}
    </div>

    <ul class="product-grid product-grid--{{ section.settings.columns }}">
      {%- if collection != blank and collection.products_count > 0 -%}
        {%- for product in collection.products limit: section.settings.limit -%}
          <li>{% render 'product-card', product: product %}</li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..section.settings.limit) -%}
          <li>{% render 'product-card', product: blank, index: i %}</li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "קולקציה נבחרת",
  "settings": [
    { "type": "text", "id": "heading", "label": "כותרת", "default": "עבודות חדשות מהתנור" },
    { "type": "collection", "id": "collection", "label": "קולקציה" },
    { "type": "range", "id": "limit", "label": "מספר מוצרים", "min": 2, "max": 12, "step": 1, "default": 8 },
    { "type": "select", "id": "columns", "label": "עמודות במחשב", "default": "4", "options": [
      { "value": "3", "label": "3" }, { "value": "4", "label": "4" }
    ] }
  ],
  "presets": [{ "name": "קולקציה נבחרת" }]
}
{% endschema %}

<article class="section">
  <div class="page-width page-width--narrow">
    <header class="page-header">
      <p class="eyebrow">{{ article.published_at | time_tag: format: 'date' }}</p>
      <h1 class="page-title">{{ article.title }}</h1>
    </header>
    {%- if article.image -%}
      <div class="article__media">
        {{ article.image | image_url: width: 1600 | image_tag: loading: 'eager', sizes: '(min-width: 990px) 760px, 100vw', alt: article.title }}
      </div>
    {%- endif -%}
    <div class="rte">{{ article.content }}</div>
    <p><a class="link-arrow" href="{{ blog.url }}">{{ 'blog.back' | t }}</a></p>
  </div>
</article>

{% schema %}
{
  "name": "מאמר"
}
{% endschema %}

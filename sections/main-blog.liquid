<section class="section">
  <div class="page-width">
    <header class="page-header">
      <h1 class="page-title">{{ blog.title }}</h1>
    </header>
    {%- paginate blog.articles by 9 -%}
      <ul class="article-grid">
        {%- for article in blog.articles -%}
          <li>
            <a class="article-card" href="{{ article.url }}">
              {%- if article.image -%}
                <div class="article-card__media">
                  {{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 33vw, 100vw', alt: article.title }}
                </div>
              {%- endif -%}
              <p class="eyebrow">{{ article.published_at | time_tag: format: 'date' }}</p>
              <h2 class="article-card__title">{{ article.title }}</h2>
              <p>{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p>
            </a>
          </li>
        {%- endfor -%}
      </ul>
      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "בלוג"
}
{% endschema %}

{%- comment -%}
  Layouts:
  - full:  image fills the banner, text over it (best for wide landscape photos)
  - split: text beside the image (best for portrait product photos)
  Without an uploaded image, the split layout falls back to a bundled product photo.
{%- endcomment -%}
{%- assign split = false -%}
{%- if section.settings.layout == 'split' -%}{%- assign split = true -%}{%- endif -%}

{%- if split -%}
  <section class="hero-split">
    <div class="page-width hero-split__inner">
      <div class="hero-split__content">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h1 class="hero__heading">{{ section.settings.heading }}</h1>{%- endif -%}
        {%- if section.settings.text != blank -%}<div class="hero__text">{{ section.settings.text }}</div>{%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a class="button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
        {%- endif -%}
      </div>
      <div class="hero-split__media">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 990px) 45vw, 100vw', widths: '600, 900, 1200, 1400', alt: section.settings.image.alt }}
        {%- else -%}
          <img src="{{ 'product-red-riding-hood-theater-lamp.jpg' | asset_url }}" alt="{{ 'sections.hero.fallback_alt' | t }}" width="747" height="1000" loading="eager" fetchpriority="high">
        {%- endif -%}
      </div>
    </div>
  </section>
{%- else -%}
<section class="hero hero--{{ section.settings.height }}">
  <div class="hero__media">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '100vw', widths: '750, 1100, 1500, 2000, 2400', alt: section.settings.image.alt }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder' }}
    {%- endif -%}
  </div>
  <div class="hero__overlay" style="--overlay: {{ section.settings.overlay | divided_by: 100.0 }}"></div>
  <div class="page-width hero__content">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h1 class="hero__heading">{{ section.settings.heading }}</h1>{%- endif -%}
    {%- if section.settings.text != blank -%}<div class="hero__text">{{ section.settings.text }}</div>{%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a class="button button--light" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Hero banner",
  "settings": [
    { "type": "select", "id": "layout", "label": "Layout", "default": "split", "options": [
      { "value": "split", "label": "Text beside image (portrait photos)" }, { "value": "full", "label": "Full-width image (landscape photos)" }
    ] },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "range", "id": "overlay", "label": "Image overlay", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 30 },
    { "type": "select", "id": "height", "label": "Height", "default": "large", "options": [
      { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" }
    ] },
    { "type": "text", "id": "eyebrow", "label": "Small text above heading", "default": "Ceramics studio" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Handmade pieces for everyday use" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Handmade ceramic lamps, cake stands and wall art for kids' rooms and the living room.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop all pieces" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Hero banner" }]
}
{% endschema %}

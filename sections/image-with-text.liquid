<section class="section">
  <div class="page-width image-text image-text--{{ section.settings.layout }}">
    <div class="image-text__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 50vw, 100vw', widths: '600, 900, 1200, 1400', alt: section.settings.image.alt }}
      {%- else -%}
        {{ 'image' | placeholder_svg_tag: 'placeholder' }}
      {%- endif -%}
    </div>
    <div class="image-text__content">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="section__heading">{{ section.settings.heading }}</h2>{%- endif -%}
      <div class="rte">{{ section.settings.text }}</div>
      {%- if section.settings.button_label != blank -%}
        <a class="button button--outline" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with text",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "select", "id": "layout", "label": "Image position", "default": "image-first", "options": [
      { "value": "image-first", "label": "Image first" }, { "value": "image-last", "label": "Image last" }
    ] },
    { "type": "text", "id": "eyebrow", "label": "Small text", "default": "About the studio" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Hi, I'm Levana" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>I've been making pottery for years in a small studio near my home. Every piece starts as a lump of clay on the wheel, then goes through drying, a first firing, hand glazing and a second firing.</p><p>I love simple shapes, natural glazes and the small marks that hands leave behind.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Read the full story" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Image with text" }]
}
{% endschema %}

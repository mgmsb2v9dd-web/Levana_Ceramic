<section class="section">
  <div class="page-width image-text image-text--{{ section.settings.layout }}">
    <div class="image-text__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 50vw, 100vw', widths: '600, 900, 1200, 1400', alt: section.settings.image.alt }}
      {%- else -%}
        {{ 'image' | placeholder_svg_tag: 'placeholder' }}
      {%- endif -%}
    </div>
    <div class="image-text__content">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="section__heading">{{ section.settings.heading }}</h2>{%- endif -%}
      <div class="rte">{{ section.settings.text }}</div>
      {%- if section.settings.button_label != blank -%}
        <a class="button button--outline" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "תמונה וטקסט",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "תמונה" },
    { "type": "select", "id": "layout", "label": "מיקום תמונה", "default": "image-first", "options": [
      { "value": "image-first", "label": "תמונה בהתחלה" }, { "value": "image-last", "label": "תמונה בסוף" }
    ] },
    { "type": "text", "id": "eyebrow", "label": "טקסט קטן", "default": "על הסטודיו" },
    { "type": "text", "id": "heading", "label": "כותרת", "default": "נעים להכיר, אני לבנה" },
    { "type": "richtext", "id": "text", "label": "טקסט", "default": "<p>אני יוצרת כלים מחומר כבר שנים, בסטודיו קטן ליד הבית. כל כלי מתחיל כגוש חימר על האובניים, עובר ייבוש, שריפה ראשונה, זיגוג ידני ושריפה שנייה.</p><p>אני אוהבת צורות פשוטות, זיגוגים טבעיים והטביעות הקטנות שהידיים משאירות.</p>" },
    { "type": "text", "id": "button_label", "label": "טקסט כפתור", "default": "לסיפור המלא" },
    { "type": "url", "id": "button_link", "label": "קישור כפתור" }
  ],
  "presets": [{ "name": "תמונה וטקסט" }]
}
{% endschema %}

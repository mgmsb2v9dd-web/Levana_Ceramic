<!doctype html>
<html lang="{{ request.locale.iso_code }}" dir="{{ 'general.direction' | t }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ shop.name }}</title>
    <link href="https://fonts.googleapis.com/css2?family=Frank+Ruhl+Libre:wght@400;700&family=Assistant:wght@300;400;600&display=swap" rel="stylesheet">
    <style>
      :root {
        --color-bg: {{ settings.color_background }};
        --color-surface: {{ settings.color_surface }};
        --color-text: {{ settings.color_text }};
        --color-muted: {{ settings.color_muted }};
        --color-accent: {{ settings.color_accent }};
        --color-accent-contrast: {{ settings.color_accent_contrast }};
        --color-border: {{ settings.color_border }};
        --page-width: {{ settings.page_width }}px;
        --radius: {{ settings.corner_radius }}px;
        --font-heading: 'Frank Ruhl Libre', Georgia, serif;
        --font-body: 'Assistant', 'Segoe UI', Arial, sans-serif;
      }
    </style>
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="template-password">
    <main id="MainContent">
      {{ content_for_layout }}
    </main>
  </body>
</html>
